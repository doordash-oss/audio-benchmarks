#!/usr/bin/env python3
"""Generate _data/clips.yml from Full-Duplex-Bench/report_clips/ directories.

Reads info.json + tool_calls.json from each clip directory and emits a YAML
file consumed by _includes/clip.html. Re-run this whenever new clips are
exported.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

REPORT_DIR = Path(os.environ.get(
    "REPORT_CLIPS_DIR",
    "/Users/daniel.fischetti/Projects/Full-Duplex-Bench/report_clips",
))
OUT = Path(__file__).resolve().parent.parent / "_data" / "clips.yml"
MEDIA_DIR = Path(__file__).resolve().parent.parent / "assets" / "media"


def format_args(tool: str, args: dict) -> str:
    parts = []
    if "item_id" in args:
        parts.append(args["item_id"])
    options = args.get("options") or {}
    for key, values in options.items():
        vs = ", ".join(values) if isinstance(values, list) else str(values)
        parts.append(f"{key}: {vs}")
    return ", ".join(parts)


def yaml_escape(s: str) -> str:
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def main() -> int:
    if not REPORT_DIR.is_dir():
        print(f"error: {REPORT_DIR} not found", file=sys.stderr)
        return 1

    OUT.parent.mkdir(parents=True, exist_ok=True)
    lines: list[str] = ["# generated by bin/generate-clip-data — do not edit by hand"]

    # Dedupe by task_id: a single task can have multiple exports (different
    # windows). Pick the most recently modified one.
    latest: dict[str, Path] = {}
    for sub in REPORT_DIR.glob("order_up.*"):
        info_path = sub / "info.json"
        calls_path = sub / "tool_calls.json"
        if not (info_path.exists() and calls_path.exists()):
            continue
        info = json.loads(info_path.read_text())
        task_id = info["task_id"]
        if task_id not in latest or sub.stat().st_mtime > latest[task_id].stat().st_mtime:
            latest[task_id] = sub

    for task_id, sub in sorted(latest.items()):
        info = json.loads((sub / "info.json").read_text())
        calls = json.loads((sub / "tool_calls.json").read_text())

        if not (MEDIA_DIR / f"{task_id}.mp3").exists():
            continue

        lines.append(f"- id: {task_id}")
        lines.append(f"  run_ts: \"{info.get('run_ts', '')}\"")
        lines.append(f"  window_start: {info['window']['start_s']}")
        lines.append(f"  window_end: {info['window']['end_s']}")
        if calls:
            lines.append("  calls:")
            for c in calls:
                lines.append(f"    - t: {c['t_run_s']}")
                lines.append(f"      tool: {c['tool']}")
                lines.append(f"      args: {yaml_escape(format_args(c['tool'], c.get('args') or {}))}")
                lines.append(f"      ok: {'true' if c.get('result_ok', True) else 'false'}")
        else:
            lines.append("  calls: []")

        transcript_path = sub / "transcript.json"
        if transcript_path.exists():
            transcript = json.loads(transcript_path.read_text())
            if transcript:
                lines.append("  transcript:")
                for turn in transcript:
                    lines.append(f"    - role: {turn['role']}")
                    lines.append(f"      t: {turn['t_run_s']}")
                    lines.append(f"      text: {yaml_escape(turn['text'])}")

    OUT.write_text("\n".join(lines) + "\n")
    print(f"wrote {OUT} ({sum(1 for l in lines if l.startswith('- id:'))} clips)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
