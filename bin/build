# Build the Jekyll site into docs/ for GitHub Pages legacy-mode serving.
# Actions is disabled at the org, so we build locally and commit docs/.
set -euo pipefail

cd "$(dirname "$0")/.."

if [ -x /opt/homebrew/opt/ruby/bin/ruby ]; then
  export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
fi

if ! command -v bundle >/dev/null 2>&1; then
  echo "error: bundler not found. Install Ruby 3.x (e.g. 'brew install ruby') and re-run." >&2
  exit 1
fi

if [ ! -d vendor/bundle ]; then
  bundle config set --local path 'vendor/bundle'
  bundle install
fi

rm -rf docs
bundle exec jekyll build --destination docs
touch docs/.nojekyll

echo
echo "Built docs/. To publish:"
echo "  git add docs/ && git commit -m 'rebuild site' && git push"
